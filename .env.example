# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/f10_db
DATABASE_POOL_MAX=10

# OpenAI support agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=25000
SUPPORT_AI_CHAT_ENABLED=false

# Help video automation (optional)
# Install FFmpeg on the application server to process MP4 and extract audio/screenshots.
# Install yt-dlp only if the YouTube URL source should be available.
HELP_VIDEO_FFMPEG_PATH=ffmpeg
HELP_VIDEO_YTDLP_PATH=yt-dlp

# Native support chat
SUPPORT_RATE_LIMIT_SECRET=change-this-to-a-random-secret-with-at-least-32-characters

# Public Help Center AI
# Separate random secret used to sign anonymous sessions and hash traffic identifiers. Keep at least 32 characters.
HELP_PUBLIC_AI_SECRET=change-this-to-a-different-random-secret-with-at-least-32-characters

# Customer portal and transactional support e-mail
# localhost can use the request origin; configure the canonical HTTPS URL before production
CUSTOMER_PORTAL_BASE_URL=http://localhost:5179
# Legacy F10 account authentication used by customers before chat/tickets.
F10_BACKEND_URL=https://backend.f10.com.br
# Random application secret used only to encrypt the legacy F10 JWT at rest. Keep at least 32 characters.
F10_CUSTOMER_TOKEN_KEY=
# Optional canonical URL for guided training magic links. In local development it can reuse the request origin.
TRAINING_BASE_URL=http://localhost:5179
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=F10 Software

# Google Calendar OAuth - one connection per Operations user
# Create a Web application OAuth client and authorize this exact localhost callback while developing locally.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Random application secret used only to encrypt Google refresh tokens at rest. Keep at least 32 characters.
GOOGLE_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5179/app/tasks/calendar/google/callback

# Help Center asset storage (MinIO / S3 compatible)
ASSET_STORAGE=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=f10-help
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Remote support - public MeshCentral endpoint on the same F10 domain
REMOTE_SUPPORT_PROVIDER=meshcentral
MESHCENTRAL_BASE_URL=https://f10.com.br/acesso-remoto/

# Remote support - automatic enrollment/control through MeshCtrl
MESHCENTRAL_MESHCTRL_PATH=/opt/meshcentral/node_modules/meshcentral/meshctrl.js
MESHCENTRAL_CONTROL_URL=ws://172.17.0.1:4430/acesso-remoto/
MESHCENTRAL_CONTROL_USER=f10-operations
MESHCENTRAL_CONTROL_DOMAIN=acesso-remoto
MESHCENTRAL_CONTROL_LOGIN_KEY_FILE=
MESHCENTRAL_CONTROL_PASSWORD=
# MeshCentral ARCHID 4 = Windows x64. Change only if the supported client platform changes.
MESHCENTRAL_WINDOWS_AGENT_TYPE=4
# Desktop Prompt: the customer confirms access on the local computer.
MESHCENTRAL_DEVICE_CONSENT_FLAGS=8
# Temporary DeviceSharing link lifetime. MeshCentral domain limit is configured at 60 minutes.
MESHCENTRAL_SHARE_MINUTES=30
REMOTE_ENROLLMENT_HOURS=24

# First Super Admin bootstrap
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_NAME=Administrador F10
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-this-to-a-strong-password
BOOTSTRAP_SUPER_ADMIN_FORCE_PASSWORD=false

# Operations canonical URL - used by password-reset links and local smoke tests
OPERATIONS_BASE_URL=http://localhost:5179
OPERATIONS_SMOKE_EMAIL=admin@example.com
OPERATIONS_SMOKE_PASSWORD=change-this-to-the-test-account-password

# Optional doctor behavior
OPERATIONS_DOCTOR_REQUIRE_SUPER_ADMIN=true
OPERATIONS_DOCTOR_REQUIRE_OPENAI=false
OPERATIONS_DOCTOR_REQUIRE_ASSET_STORAGE=false
OPERATIONS_DOCTOR_REQUIRE_REMOTE=false
