# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/f10_db
DATABASE_POOL_MAX=10

# First Super Admin bootstrap
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_NAME=Administrador F10
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-this-to-a-strong-password
BOOTSTRAP_SUPER_ADMIN_FORCE_PASSWORD=false

# Operations smoke test
OPERATIONS_BASE_URL=http://localhost:5173
OPERATIONS_SMOKE_EMAIL=admin@example.com
OPERATIONS_SMOKE_PASSWORD=change-this-to-the-test-account-password

# Optional doctor behavior
OPERATIONS_DOCTOR_REQUIRE_SUPER_ADMIN=true
