{
  "name": "f10-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "dev:wsl": "CHOKIDAR_USEPOLLING=1 vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "svelte-kit sync",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-super-admin.mjs",
    "operations:doctor": "node --env-file-if-exists=.env scripts/operations-doctor.mjs",
    "operations:smoke": "node --env-file-if-exists=.env scripts/operations-smoke.mjs",
    "support:doctor": "node --env-file-if-exists=.env scripts/support-doctor.mjs",
    "production:doctor": "npm run operations:doctor && npm run support:doctor"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.47.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/archiver": "^7.0.0",
    "@types/node": "^24.10.1",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.10.0",
    "postcss": "^8.4.47",
    "svelte": "^5.1.9",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@opentelemetry/api": "^1.9.1",
    "archiver": "^7.0.1",
    "drizzle-orm": "0.45.2",
    "lucide-svelte": "^0.554.0",
    "postgres": "3.4.9"
  }
}
