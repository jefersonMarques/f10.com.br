+    $dependencies = $isSinglePost
+        ? ['f10-single-post']
+        : ['astra-parent-style', 'f10-author-fonts'];
+
+    if (!$isSinglePost) {
+        wp_enqueue_style(
+            'f10-author-fonts',
+            'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap',
+            [],
+            null
+        );
+    }
+
+    wp_enqueue_style(
+        'f10-author',
+        get_stylesheet_directory_uri() . $cssRelativePath,
+        $dependencies,
+        $cssVersion
+    );
