+if (!function_exists('f10_count_words')) {
+    /**
+     * Conta palavras com suporte a caracteres Unicode.
+     */
+    function f10_count_words(string $content): int
+    {
+        $plainText = wp_strip_all_tags($content);
+        $matchCount = preg_match_all("/[\\p{L}\\p{N}]+(?:[’'][\\p{L}\\p{N}]+)*/u", $plainText, $matches);
+
+        return $matchCount === false ? 0 : $matchCount;
+    }
+}
